# DataLedger 环境变量模板
#
# 复制成 .env 后填入真实值再运行：
#     cp env.example .env
#
# .env 已在 .gitignore 里，不会入库、不会进对话记录。
# 这个模板文件本身可以入库 —— 它只描述"需要哪些配置"，不含任何凭据。

# ---------------------------------------------------------------- PostgreSQL
# 注意：密码首字符是**半角** !，不能用全角 ！ —— 用错了会直接认证失败。
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=dataledger
# 上面几项是给 psql / pgAdmin 用的；代码只读这一条 DSN
DATALEDGER_DSN=postgresql://postgres:<password>@127.0.0.1:5432/dataledger

# ------------------------------------------------- 执行限制（评测期软护栏）
# 单条 SQL 的执行上限（毫秒）。防止模型生成隐式笛卡尔积把评测卡死。
DATALEDGER_STMT_TIMEOUT_MS=10000
# 结果集最多保留多少行，超出截断并标记
DATALEDGER_MAX_ROWS=5000

# ------------------------------------------------------------- 大模型（可选）
# 只有 `python eval/run_eval.py --engine llm` 需要这一段。
# gold 引擎、单元测试、判分器验证都不需要 API key。
#
# 申请地址：platform.deepseek.com → API Keys → 创建
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名：deepseek-chat / deepseek-reasoner 已于 2026-07-24 弃用，
# 现在用 deepseek-v4-flash（快、便宜）或 deepseek-v4-pro（强推理）。
DEEPSEEK_MODEL=deepseek-v4-flash
# 评测要可复现，温度固定 0；改这个值会让两次跑的准确率不可比
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=8192
# ⚠️ 别设太小。deepseek-v4-flash 是推理模型，reasoning_content 和正文**共用**这个额度：
# 推理一吃满，正文就是空的，返回的 finish_reason=length。
# 曾经用 1024 跑出 2 条"模型返回了空内容"——那是配置截断，不是模型不会答。
DEEPSEEK_TIMEOUT_S=60

# 价格用于把 token 折成成本（美元/百万 token），随官方调整；
# 默认值取自 2026-10 的 flash 档。USD_TO_CNY 用于换算成人民币。
DEEPSEEK_PRICE_IN=0.15
DEEPSEEK_PRICE_OUT=0.60
USD_TO_CNY=7.1
